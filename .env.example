# 서버 포트
PORT=3001
NODE_ENV=development

# 프론트엔드(웹앱)가 실제로 서비스되는 정확한 주소 (쿠키 세션 때문에 * 불가)
# 로컬 개발 시 프론트를 http://localhost:5500 같은 걸로 띄운다면 그 주소를 넣으세요.
ALLOWED_ORIGIN=http://localhost:5500

# 세션 토큰 서명용 비밀키 - 아무도 못 맞출 긴 임의 문자열로 바꿔주세요
JWT_SECRET=change-this-to-a-long-random-string

# 관리자 페이지 접근을 허용할 이메일 (쉼표로 여러 개 구분 가능)
ADMIN_EMAILS=you@example.com

# --- SMTP (이메일 발송) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-account@gmail.com

# --- AI 대화 (Anthropic API) ---
# console.anthropic.com에서 발급받은 키. 절대 프론트엔드 코드에 넣지 마세요.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
